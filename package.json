{
  "name": "repovista",
  "version": "0.1.0",
  "description": "Read-only Codex-powered repository audit reports from a local CLI.",
  "type": "module",
  "bin": {
    "repovista": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-cli-executable.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "codex",
    "cli",
    "audit",
    "repository",
    "architecture",
    "code-review"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/repovista/repovista.git"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3"
  }
}
