{
  "name": "repovista",
  "version": "0.5.0",
  "description": "Read-only AI-powered repository audit reports from local provider CLIs.",
  "type": "module",
  "bin": {
    "repovista": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-cli-executable.mjs",
    "docs:prepare": "npm install --no-save --no-package-lock --no-audit --no-fund vitepress@1.6.4",
    "docs:dev": "npm run docs:prepare && vitepress dev docs --host 0.0.0.0",
    "docs:build": "npm run docs:prepare && vitepress build docs",
    "docs:preview": "npm run docs:prepare && vitepress preview docs --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "golden:reports": "npm run build && node scripts/check-golden-reports.mjs",
    "security:audit": "npm audit --audit-level=moderate",
    "test": "npm run build && node scripts/run-tests.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "codex",
    "claude",
    "ai",
    "cli",
    "audit",
    "repository",
    "architecture",
    "code-review"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nordbyte/RepoVista.git"
  },
  "bugs": {
    "url": "https://github.com/nordbyte/RepoVista/issues"
  },
  "homepage": "https://repovista.com",
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3"
  }
}
